{
  "name": "atlas-repack-library",
  "version": "0.3.0",
  "private": true,
  "description": "Ravenshelf: a privacy-hardened game catalogue and batch download manager for Windows",
  "author": "Ravenshelf contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khattabhunter/ravenshelf.git"
  },
  "homepage": "https://github.com/khattabhunter/ravenshelf#readme",
  "bugs": {
    "url": "https://github.com/khattabhunter/ravenshelf/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  },
  "build": {
    "appId": "local.atlas.repacklibrary",
    "productName": "Ravenshelf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Ravenshelf-${version}-Windows.exe"
    }
  }
}
